CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Realm/core"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/AFNetworking" "${PODS_ROOT}/Headers/Public/APLRUCache" "${PODS_ROOT}/Headers/Public/DACircularProgress" "${PODS_ROOT}/Headers/Public/MBProgressHUD" "${PODS_ROOT}/Headers/Public/MWPhotoBrowser" "${PODS_ROOT}/Headers/Public/OpenSSL-Universal" "${PODS_ROOT}/Headers/Public/QBImagePickerController" "${PODS_ROOT}/Headers/Public/Realm" "${PODS_ROOT}/Headers/Public/SDWebImage" "${PODS_ROOT}/Headers/Public/SVProgressHUD" "${PODS_ROOT}/Headers/Public/SVPullToRefresh" "${PODS_ROOT}/Headers/Public/SWTableViewCell" "${PODS_ROOT}/Headers/Public/Seafile" "${PODS_ROOT}/Headers/Public/WechatOpenSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Realm/Headers"
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "${PODS_CONFIGURATION_BUILD_DIR}/APLRUCache" "${PODS_CONFIGURATION_BUILD_DIR}/DACircularProgress" "${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" "${PODS_CONFIGURATION_BUILD_DIR}/MWPhotoBrowser" "${PODS_CONFIGURATION_BUILD_DIR}/QBImagePickerController" "${PODS_CONFIGURATION_BUILD_DIR}/Realm" "${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "${PODS_CONFIGURATION_BUILD_DIR}/SVProgressHUD" "${PODS_CONFIGURATION_BUILD_DIR}/SVPullToRefresh" "${PODS_CONFIGURATION_BUILD_DIR}/SWTableViewCell" "${PODS_CONFIGURATION_BUILD_DIR}/Seafile" "${PODS_ROOT}/OpenSSL-Universal/lib-ios" "${PODS_ROOT}/WechatOpenSDK/OpenSDK1.8.7.1" "${PODS_XCFRAMEWORKS_BUILD_DIR}/Realm"
OTHER_LDFLAGS = $(inherited) -ObjC -l"AFNetworking" -l"APLRUCache" -l"DACircularProgress" -l"MBProgressHUD" -l"MWPhotoBrowser" -l"QBImagePickerController" -l"Realm" -l"SDWebImage" -l"SVProgressHUD" -l"SVPullToRefresh" -l"SWTableViewCell" -l"Seafile" -l"WeChatSDK" -l"c++" -l"compression" -l"crypto" -l"realm-monorepo" -l"sqlite3.0" -l"ssl" -l"z" -framework "AssetsLibrary" -framework "CoreGraphics" -framework "Foundation" -framework "ImageIO" -framework "MediaPlayer" -framework "Photos" -framework "QuartzCore" -framework "Security" -framework "UIKit" -framework "WebKit" -weak_framework "Photos" -weak_framework "UIKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AFNetworking" "-F${PODS_CONFIGURATION_BUILD_DIR}/APLRUCache" "-F${PODS_CONFIGURATION_BUILD_DIR}/DACircularProgress" "-F${PODS_CONFIGURATION_BUILD_DIR}/MBProgressHUD" "-F${PODS_CONFIGURATION_BUILD_DIR}/MWPhotoBrowser" "-F${PODS_CONFIGURATION_BUILD_DIR}/OpenSSL-Universal" "-F${PODS_CONFIGURATION_BUILD_DIR}/QBImagePickerController" "-F${PODS_CONFIGURATION_BUILD_DIR}/Realm" "-F${PODS_CONFIGURATION_BUILD_DIR}/SDWebImage" "-F${PODS_CONFIGURATION_BUILD_DIR}/SVProgressHUD" "-F${PODS_CONFIGURATION_BUILD_DIR}/SVPullToRefresh" "-F${PODS_CONFIGURATION_BUILD_DIR}/SWTableViewCell" "-F${PODS_CONFIGURATION_BUILD_DIR}/Seafile" "-F${PODS_CONFIGURATION_BUILD_DIR}/WechatOpenSDK"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
